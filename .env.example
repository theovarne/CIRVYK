# Optional server configuration. Example inputs work with these values empty.
# Use: node --env-file=.env scripts/dev.mjs
CIRCUIT_NETWORK=mainnet-beta
CIRCUIT_MINT=
CIRCUIT_OBSERVED_ACCOUNTS=

# Server-only RPC overrides. Never commit real credentials.
SOLANA_RPC_URL=
SOLANA_RPC_API_KEY=

# Local development server only.
PORT=5175
